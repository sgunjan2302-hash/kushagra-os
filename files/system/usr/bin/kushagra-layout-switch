#!/usr/bin/env bash
set -euo pipefail

# Kushagra OS - Adaptive Desktop Layout Switcher (Plasma 6 Wayland)
# Toggles between "classic" (Windows-like bottom taskbar) and "floating" (macOS-like top bar + dock)

LAYOUT_DIR="/usr/share/kushagra-os/layouts"

# Discover appropriate Qt6 DBus binary
QDBUS_BIN=""
for candidate in qdbus-qt6 /usr/lib64/qt6/bin/qdbus qdbus6 qdbus; do
    if command -v "$candidate" >/dev/null 2>&1; then
        QDBUS_BIN="$candidate"
        break
    fi
done

if [ -z "$QDBUS_BIN" ]; then
    echo "ERROR: Could not locate a working qdbus/qdbus6 binary." >&2
    exit 1
fi

apply_layout() {
    local layout="$1"
    local script_file=""

    case "$layout" in
        classic|familiar|windows)
            script_file="${LAYOUT_DIR}/windows-classic.js"
            echo "Applying Kushagra OS 'Familiar Mode' (Windows-like bottom taskbar)..."
            ;;
        floating|studio|macos)
            script_file="${LAYOUT_DIR}/modern-floating.js"
            echo "Applying Kushagra OS 'Studio Mode' (Modern top bar + floating dock)..."
            ;;
        *)
            echo "Invalid layout specified: $layout" >&2
            echo "Usage: $(basename "$0") [classic|floating]" >&2
            return 1
            ;;
    esac

    if [ ! -f "$script_file" ]; then
        echo "ERROR: Layout script not found at ${script_file}" >&2
        return 1
    fi

    # Evaluate the layout script via PlasmaShell DBus interface
    "$QDBUS_BIN" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$(< "$script_file")"
    echo "Layout '${layout}' applied successfully."
}

# Interactive selection if no argument is passed
if [ $# -eq 0 ]; then
    echo "====================================================="
    echo "       Kushagra OS Desktop Layout Switcher           "
    echo "====================================================="
    echo "1) Familiar Mode (Windows-like bottom panel)"
    echo "2) Studio Mode (macOS-like top bar + floating dock)"
    echo "3) Exit"
    read -rp "Select layout [1-3]: " choice
    case "$choice" in
        1) apply_layout "classic" ;;
        2) apply_layout "floating" ;;
        3) echo "Exiting without changes."; exit 0 ;;
        *) echo "Invalid choice."; exit 1 ;;
    esac
else
    apply_layout "$1"
fi
