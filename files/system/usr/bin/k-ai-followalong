#!/usr/bin/env python3
"""Kushagra OS K-AI FollowAlong Quick-Action Selector (Ctrl+Shift+A).

Reads the highlighted Wayland primary selection (`wl-paste --primary --no-newline`),
falls back to standard clipboard (`wl-paste --no-newline`) cleanly without failing on
empty clipboards, and opens a compact frosted-glass Qt6 selector with 4 instant modes:
Translate (EN<->HI), Summarize, Fix Grammar, and Explain Code.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from PyQt6.QtCore import QByteArray, QObject, QSize, Qt, QUrl, pyqtProperty, pyqtSlot
from PyQt6.QtGui import QClipboard, QGuiApplication, QWindow
from PyQt6.QtQml import QQmlApplicationEngine

MAX_DIRECT_CONTEXT_CHARS = 16000

