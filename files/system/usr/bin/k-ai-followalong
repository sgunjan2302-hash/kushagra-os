def _read_wl_paste(primary: bool) -> str:
    wl_paste = shutil.which("wl-paste")
    if not wl_paste:
        return ""
    cmd = [wl_paste, "--primary", "--no-newline"] if primary else [wl_paste, "--no-newline"]
    try:
        res = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if res.returncode == 0:
            return res.stdout or ""
    except Exception:
        pass
    return ""


def read_selection_or_clipboard(app: QGuiApplication) -> tuple[str, str]:
    """Read highlighted primary selection, falling back cleanly to clipboard."""
    primary_text = _read_wl_paste(primary=True)
    if primary_text.strip():
        return primary_text, "Primary Selection"

    clip_text = _read_wl_paste(primary=False)
    if clip_text.strip():
        return clip_text, "Clipboard"

    try:
        cb = app.clipboard()
        if cb is not None:
            qt_sel = cb.text(QClipboard.Mode.Selection)
            if qt_sel and qt_sel.strip():
                return qt_sel, "Selection"
            qt_clip = cb.text(QClipboard.Mode.Clipboard)
            if qt_clip and qt_clip.strip():
                return qt_clip, "Clipboard"
    except Exception:
        pass

    return "", "Empty Clipboard"


class FollowAlongBackend(QObject):
    """Bridge exposing selection context and launching k-ai-drawer."""

    def __init__(self, selected_text: str, source_label: str, parent=None):
        super().__init__(parent)
        self._selected_text = selected_text
        self._source_label = source_label

    @pyqtProperty(str, constant=True)
    def selectedText(self) -> str:
        return self._selected_text

    @pyqtProperty(str, constant=True)
    def selectionSource(self) -> str:
        return self._source_label

    @pyqtSlot(str, str)
    def launchAction(self, action_mode: str, context_text: str) -> None:
        drawer_bin = "/usr/bin/k-ai-drawer"
        if not os.path.exists(drawer_bin):
            drawer_bin = shutil.which("k-ai-drawer") or drawer_bin

        cmd = [drawer_bin]
        if action_mode.strip():
            cmd.extend(["--action", action_mode.strip()])

        cleaned = context_text.strip()
        if cleaned:
            if len(cleaned) <= MAX_DIRECT_CONTEXT_CHARS:
                cmd.extend(["--context", cleaned])
            else:
                runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
                fd, tmp_path = tempfile.mkstemp(prefix="kai-ctx-", suffix=".txt", dir=runtime_dir)
                try:
                    os.chmod(tmp_path, 0o600)
                    with os.fdopen(fd, "w", encoding="utf-8") as fp:
                        fp.write(cleaned)
                    cmd.extend(["--context-file", tmp_path])
                except OSError:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                    cmd.extend(["--context", cleaned[:MAX_DIRECT_CONTEXT_CHARS]])

        try:
            subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            print(f"Failed to launch k-ai-drawer: {exc}", file=sys.stderr)
        app = QGuiApplication.instance()
        if app is not None:
            app.quit()


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="k-ai-followalong",
        description="K-AI FollowAlong quick action selector for highlighted text.",
    )
    parser.add_argument("--text", "--context", dest="text", default="", help="Override text")
    parser.add_argument("--preview", action="store_true", help="Launch with sample text")
    return parser.parse_args(argv)


def _position_window(app: QGuiApplication, win: QWindow) -> None:
    screen = app.primaryScreen()
    if not screen and app.screens():
        screen = app.screens()[0]
    if not screen:
        return
    geo = screen.availableGeometry()
    if geo.width() <= 0 or geo.height() <= 0:
        geo = screen.geometry()
    if geo.width() <= 0 or geo.height() <= 0:
        return
    w = min(440, max(360, geo.width() - 32))
    h = min(370, max(310, geo.height() - 48))
    x = geo.x() + max(0, (geo.width() - w) // 2)
    y = geo.y() + max(16, int(geo.height() * 0.18))
    win.setMinimumSize(QSize(360, 300))
    win.setScreen(screen)
    win.setGeometry(x, y, w, h)


def main() -> int:
    args = parse_args(sys.argv[1:])

    try:
        from PyQt6.QtQuickControls2 import QQuickStyle
        QQuickStyle.setStyle("Basic")
    except Exception:
        pass

    app = QGuiApplication(sys.argv)
    app.setApplicationName("K-AI FollowAlong")
    app.setOrganizationName("Kushagra OS")

    if args.text.strip():
        selected_text = args.text
        source_label = "Context"
    elif args.preview:
        selected_text = "systemctl --user status k-ai-engine.service"
        source_label = "Preview"
    else:
        selected_text, source_label = read_selection_or_clipboard(app)

    engine = QQmlApplicationEngine()
    backend = FollowAlongBackend(selected_text, source_label, parent=engine)

    logo_path = Path("/usr/share/kushagra-os/branding/logo-symbol.svg")
    if not logo_path.exists():
        logo_path = Path(__file__).resolve().parents[1] / "share" / "kushagra-os" / "branding" / "logo-symbol.svg"

    ctx = engine.rootContext()
    ctx.setContextProperty("followBackend", backend)
    ctx.setContextProperty("kushagraLogoUrl", QUrl.fromLocalFile(str(logo_path)))

    engine.loadData(QByteArray(FOLLOWALONG_QML.encode("utf-8")))
    if not engine.rootObjects():
        return 1

    win = engine.rootObjects()[0]
    if isinstance(win, QWindow):
        _position_window(app, win)

    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
