#!/usr/bin/env bash
set -euo pipefail

# Kushagra OS - Read-Only VM Smoke Test & Runtime Health Verification Tool
# Tests core OS subsystems and outputs explicit PASS / WARN / FAIL statuses

echo "================================================================================"
echo "                   Kushagra OS System Health Verification                      "
echo "================================================================================"

pass_count=0
warn_count=0
fail_count=0

record_pass() {
    echo -e "[\033[0;32mPASS\033[0m] $1"
    pass_count=$((pass_count + 1))
}

record_warn() {
    echo -e "[\033[0;33mWARN\033[0m] $1"
    warn_count=$((warn_count + 1))
}

record_fail() {
    echo -e "[\033[0;31mFAIL\033[0m] $1"
    fail_count=$((fail_count + 1))
}

# 1. bootc deployment status
echo -n "Checking bootc deployment status... "
if command -v bootc >/dev/null 2>&1; then
    if bootc status >/dev/null 2>&1; then
        record_pass "bootc is active and healthy"
    else
        record_warn "bootc is installed but not currently running in an active deployment (likely LiveCD)"
    fi
else
    record_fail "bootc command not found"
fi

# 2. ZRAM & Compression Algorithm
echo -n "Checking ZRAM configuration... "
if command -v zramctl >/dev/null 2>&1; then
    zram_info=$(zramctl --noheadings --output ALGORITHM 2>/dev/null || true)
    if [[ "$zram_info" =~ zstd ]]; then
        record_pass "ZRAM active with zstd compression"
    elif [ -n "$zram_info" ]; then
        record_warn "ZRAM active with non-zstd compression: $zram_info"
    else
        record_fail "No active ZRAM swap devices found"
    fi
else
    record_fail "zramctl utility not found"
fi

# 3. Kernel Swappiness
echo -n "Checking kernel swappiness... "
swappiness=$(sysctl -n vm.swappiness 2>/dev/null || true)
if [ "$swappiness" = "133" ]; then
    record_pass "vm.swappiness is 133 (tuned for proactive ZRAM utilization)"
else
    record_warn "vm.swappiness is $swappiness (expected 133)"
fi

# 4. Systemd Services (earlyoom, pcscd.socket, firewalld)
for svc in earlyoom.service pcscd.socket firewalld.service; do
    echo -n "Checking system service $svc... "
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        record_pass "$svc is active"
    else
        record_warn "$svc is not active (may start on-demand or require system boot)"
    fi
done

# 5. Realtek rtw89 PCIe ASPM mitigation (if hardware present)
echo -n "Checking Realtek rtw89 driver parameters... "
if [ -d "/sys/module/rtw89_pci/parameters" ]; then
    aspm_l1=$(cat /sys/module/rtw89_pci/parameters/disable_aspm_l1 2>/dev/null || true)
    if [ "$aspm_l1" = "Y" ] || [ "$aspm_l1" = "1" ]; then
        record_pass "rtw89 ASPM L1 disable applied"
    else
        record_warn "rtw89 module loaded but disable_aspm_l1 is $aspm_l1"
    fi
else
    record_pass "Realtek rtw89 hardware not active on this host (VM/non-Realtek hardware)"
fi

# 6. systemd-resolved Quad9 + Opportunistic DNS-over-TLS
echo -n "Checking systemd-resolved Quad9 DoT configuration... "
resolved_active_cfg=""
if [ -d "/etc/systemd/resolved.conf.d" ]; then
    resolved_active_cfg=$(grep -hEv '^[[:space:]]*(#|;|$)' /etc/systemd/resolved.conf.d/*.conf 2>/dev/null || true)
fi
base_resolved_cfg=""
if [ -f "/etc/systemd/resolved.conf.d/10-dot-opportunistic.conf" ]; then
    base_resolved_cfg=$(grep -Ev '^[[:space:]]*(#|;|$)' /etc/systemd/resolved.conf.d/10-dot-opportunistic.conf 2>/dev/null || true)
fi
resolve_status=""
if command -v resolvectl >/dev/null 2>&1; then
    resolve_status=$(resolvectl status 2>/dev/null || true)
fi

if printf '%s\n%s\n' "$resolved_active_cfg" "$resolve_status" | grep -Eiq 'DNSOverTLS(=|[[:space:]]+setting:[[:space:]]*)yes'; then
    record_fail "Strict DNSOverTLS=yes detected (breaks Indian captive portals!)"
elif printf '%s\n%s\n' "$resolved_active_cfg" "$resolve_status" | grep -Eq '(^|[^0-9])(9\.9\.9\.10|149\.112\.112\.10|2620:fe::10)([^0-9]|$)'; then
    record_fail "Unfiltered Quad9 (.10) DNS detected (must use filtering 9.9.9.9 / 149.112.112.112!)"
elif [ -f "/etc/systemd/resolved.conf.d/99-kushagra-captive-bypass.conf" ]; then
    record_warn "Captive-portal DNS bypass active (run 'ujust kavach-dns on' after portal login)"
elif ! printf '%s\n' "$base_resolved_cfg" | grep -q '9\.9\.9\.9' || ! printf '%s\n' "$base_resolved_cfg" | grep -iq 'DNSOverTLS=opportunistic'; then
    record_fail "10-dot-opportunistic.conf missing Quad9 filtering DNS (9.9.9.9) or DNSOverTLS=opportunistic"
elif command -v resolvectl >/dev/null 2>&1; then
    if printf '%s\n' "$resolve_status" | grep -q '9\.9\.9\.9'; then
        record_pass "Quad9 filtering DNS (9.9.9.9) active with opportunistic DoT (captive-portal safe)"
    else
        record_warn "Quad9 opportunistic DoT configured, but 9.9.9.9 not active in resolvectl status"
    fi
else
    record_warn "resolvectl command not found (10-dot-opportunistic.conf validated)"
fi

# 7. Wayland Fcitx5 IME Environment Variables & InputMethod[$i] Lock
echo -n "Checking Wayland input method environment... "
env_file="/etc/environment"
has_xmod=0
has_gtk_im=0
has_qt_im=0

if [ -f "$env_file" ]; then
    grep -q "^XMODIFIERS=" "$env_file" && has_xmod=1 || true
    grep -q "^GTK_IM_MODULE=" "$env_file" && has_gtk_im=1 || true
    grep -q "^QT_IM_MODULE=" "$env_file" && has_qt_im=1 || true
fi

if [ "$has_gtk_im" = "1" ] || [ "$has_qt_im" = "1" ]; then
    record_fail "Conflicting GTK_IM_MODULE or QT_IM_MODULE found in $env_file (breaks Wayland candidate popup)"
elif [ "$has_xmod" = "1" ]; then
    record_pass "Clean Wayland IME environment (only XMODIFIERS=@im=fcitx configured)"
else
    record_warn "XMODIFIERS not set in $env_file"
fi

echo -n "Checking KWin Wayland InputMethod[\$i] lock... "
kwin_im_lines=""
for kwin_cfg in /etc/xdg/kwinrc /etc/skel/.config/kwinrc; do
    if [ -f "$kwin_cfg" ]; then
        kwin_im_lines+="$(grep -E '^[[:space:]]*InputMethod' "$kwin_cfg" 2>/dev/null || true)"$'\n'
    fi
done

if printf '%s' "$kwin_im_lines" | grep -Eq '^[[:space:]]*InputMethod\[\$e?i\]=.*fcitx5'; then
    record_pass "KWin Wayland InputMethod locked to Fcitx5 (InputMethod[\$i])"
elif printf '%s' "$kwin_im_lines" | grep -Eq 'plasma-keyboard'; then
    record_fail "KWin Wayland InputMethod references plasma-keyboard instead of locked Fcitx5"
elif printf '%s' "$kwin_im_lines" | grep -Eq 'fcitx5'; then
    record_warn "KWin Wayland InputMethod uses Fcitx5 without immutable [\$i] lock"
else
    record_warn "KWin Wayland InputMethod[\$i] lock not found in /etc/xdg/kwinrc or /etc/skel/.config/kwinrc"
fi

# 8. Flatpak Remotes
echo -n "Checking Flatpak repositories... "
if command -v flatpak >/dev/null 2>&1; then
    if flatpak remotes 2>/dev/null | grep -q "flathub"; then
        record_pass "Flathub remote is configured"
    else
        record_warn "Flathub remote not yet initialized (service activates on first boot)"
    fi
else
    record_fail "flatpak command not found"
fi

# 9. Kushagra Kavach USBGuard Safe Default (Rule #9 Zero Lockout)
echo -n "Checking Kushagra Kavach USBGuard safety... "
usbguard_enabled=$(systemctl is-enabled usbguard.service 2>/dev/null || true)
usbguard_active=$(systemctl is-active usbguard.service 2>/dev/null || true)
if [ "$usbguard_active" = "active" ] || [ "$usbguard_enabled" = "enabled" ]; then
    if [ -s "/etc/usbguard/rules.conf" ]; then
        record_pass "usbguard.service enabled/active with non-empty /etc/usbguard/rules.conf"
    else
        record_fail "usbguard.service enabled/active without non-empty /etc/usbguard/rules.conf (HID lockout risk!)"
    fi
elif [ ! -f "/etc/systemd/system/usbguard.service.d/10-kushagra-safe.conf" ]; then
    record_warn "usbguard.service disabled, but 10-kushagra-safe.conf guard drop-in missing"
elif [ -s "/etc/usbguard/rules.conf" ]; then
    record_pass "usbguard.service disabled (safe guard active; rules staged in /etc/usbguard/rules.conf)"
else
    record_pass "usbguard.service disabled by default (Rule #9 zero-lockout safe)"
fi

# 10. Kushagra Kavach On-Demand ClamAV (No Background clamd Daemon)
echo -n "Checking Kushagra Kavach ClamAV configuration... "
if systemctl is-active --quiet clamd.service 2>/dev/null || systemctl is-active --quiet clamd@scan.service 2>/dev/null; then
    record_fail "Background clamd daemon is active (violates 4 GB RAM budget; use on-demand clamscan only)"
elif command -v clamscan >/dev/null 2>&1; then
    record_pass "clamscan available for on-demand scanning; no background clamd daemon active"
else
    record_warn "clamscan command not found (on-demand ClamAV unavailable; clamd inactive)"
fi

# 11. Kushagra Kavach Local LAN Update Mirror Status
echo -n "Checking Kushagra Kavach LAN update mirror... "
lan_mirror_conf="/etc/containers/registries.conf.d/90-kushagra-lan-mirror.conf"
if [ -f "$lan_mirror_conf" ]; then
    mirror_active=$(grep -Ev '^[[:space:]]*(#|;|$)' "$lan_mirror_conf" 2>/dev/null || true)
    if printf '%s\n' "$mirror_active" | grep -q 'ghcr\.io' \
        && printf '%s\n' "$mirror_active" | grep -q 'pull-from-mirror[[:space:]]*=[[:space:]]*"digest-only"' \
        && ! printf '%s\n' "$mirror_active" | grep -Eq 'location[[:space:]]*=[[:space:]]*"\*"'; then
        mirror_loc=$(printf '%s\n' "$mirror_active" | awk -F'"' '/^\[\[registry\.mirror\]\]/{in_m=1; next} in_m && /location[[:space:]]*=/{print $2; exit}' || true)
        record_pass "LAN mirror configured (${mirror_loc:-custom}) with ghcr.io scope and digest-only verification"
    else
        record_fail "90-kushagra-lan-mirror.conf has missing ghcr.io scope, missing digest-only policy, or wildcard rule"
    fi
else
    record_pass "LAN update mirror not configured (using direct upstream ghcr.io)"
fi

echo "================================================================================"
echo "Health Verification Summary: PASS: $pass_count | WARN: $warn_count | FAIL: $fail_count"
echo "================================================================================"

if [ "$fail_count" -gt 0 ]; then
    exit 1
fi
exit 0
