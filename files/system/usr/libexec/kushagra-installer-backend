#!/usr/bin/env python3
"""Privileged K-Installer storage scanner and offline native bootc deployment backend (via pkexec)."""

import json
import os
import shutil
import sys
import traceback

sys.path.insert(0, "/usr/share/kushagra-os/installer")
import bootc_deploy
import storage_probe

RUN_DIR = "/run/kushagra-installer"
LOG_PATH = os.path.join(RUN_DIR, "install.log")
FALLBACK_LOG_PATH = "/tmp/kushagra-install.log"


def emit_progress(percent: int, stage: str, log_lines=None) -> None:
    payload = {"percent": percent, "stage": stage, "logs": log_lines or []}
    print("PROGRESS " + json.dumps(payload), flush=True)


def run_install(payload: dict) -> int:
    target_id = str(payload.get("targetId", "")).strip()
    confirmed = bool(payload.get("confirmed", False))
    if not confirmed:
        print("Installation confirmation missing.", file=sys.stderr)
        return 1

    try:
        target, disk, _ = storage_probe.validate_target_selection(target_id)
    except Exception as exc:
        print(f"Target validation failed: {exc}", file=sys.stderr)
        return 1

    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    last_percent = 3
    install_ok = False
    err_msg = ""

    try:
        with open(LOG_PATH, "w", encoding="utf-8", newline="\n") as log_fp:
            def emit_and_log(percent: int, stage: str, log_lines=None) -> None:
                nonlocal last_percent
                if percent >= 0:
                    last_percent = max(last_percent, int(percent))
                lines = [str(ln) for ln in (log_lines or []) if str(ln).strip()]
                if stage:
                    log_fp.write(f"[{last_percent}%] {stage}\n")
                for ln in lines:
                    log_fp.write(f"{ln}\n")
                log_fp.flush()
                emit_progress(percent, stage, lines)

            emit_and_log(3, f"Validated target {target['displayName']} (EFI {target.get('espPath') or 'new'})", [
                f"Target: {target['displayName']} [{target['kind']}]",
                f"Disk: {disk['path']} ({disk['model']})",
            ])

            try:
                bootc_deploy.deploy_system(target, emit_and_log)
                install_ok = True
            except Exception as exc:
                err_msg = str(exc).strip() or exc.__class__.__name__
                log_fp.write(f"FATAL: {err_msg}\n")
                log_fp.write(traceback.format_exc())
                log_fp.flush()

        if not install_ok:
            try:
                shutil.copy2(LOG_PATH, FALLBACK_LOG_PATH)
            except Exception:
                pass
            emit_progress(
                last_percent,
                f"Installation failed: {err_msg}",
                [f"FATAL: {err_msg}", f"Inspect {FALLBACK_LOG_PATH} for full diagnostics."],
            )
            print(f"Installation failed: {err_msg}", file=sys.stderr)
            return 1
    finally:
        shutil.rmtree(RUN_DIR, ignore_errors=True)

    emit_progress(100, "Kushagra OS installed cleanly! Ready to restart into Setup Wizard.", [
        "Offline native bootc deployment completed with exit code 0.",
        "Stage 2 OOBE (/var/lib/kushagra-oobe-pending) is armed for first reboot.",
    ])
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: kushagra-installer-backend [--scan|--install]", file=sys.stderr)
        return 2

    action = sys.argv[1]
    if action == "--scan":
        print(json.dumps(storage_probe.scan_storage(allow_privileged=(os.geteuid() == 0))))
        return 0

    if action == "--install":
        if os.geteuid() != 0:
            print("Error: --install requires root privileges via pkexec.", file=sys.stderr)
            return 1
        try:
            payload = json.load(sys.stdin)
        except Exception as exc:
            print(f"Invalid installer JSON payload: {exc}", file=sys.stderr)
            return 1
        return run_install(payload)

    print(f"Unknown action: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
