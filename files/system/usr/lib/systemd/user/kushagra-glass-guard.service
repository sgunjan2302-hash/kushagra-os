[Unit]
Description=Kushagra OS Liquid Glass Hardware & Low-RAM Guard
ConditionUser=!kushagra-oobe
PartOf=graphical-session.target
After=plasma-kwin_wayland.service

[Service]
Type=oneshot
ExecStart=/usr/bin/kushagra-glass-guard
Slice=background.slice

[Install]
WantedBy=plasma-workspace-wayland.target
