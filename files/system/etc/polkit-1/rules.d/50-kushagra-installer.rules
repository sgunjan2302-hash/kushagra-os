// Allow liveuser during rd.live.image LiveCD sessions to run Kushagra OS's
// scoped K-Installer backend (storage probe + Anaconda Kickstart execution) without prompts.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.kushagraos.installer.run") {
        return;
    }
    if (subject.user === "liveuser" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
